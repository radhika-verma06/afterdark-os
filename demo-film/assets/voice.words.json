 "sentences": [
  {
   "text": "Campus lighting reports are scattered across emails, spreadsheets and maintenance requests.",
   "start": 0,
   "end": 5.177
  },
  {
   "text": "When the budget is limited, which repair should happen first?",
   "start": 5.427,
   "end": 8.452
  },
  {
   "text": "AfterDark OS puts every report on one campus map.",
   "start": 8.703,
   "end": 12.101
  },
  {
   "text": "Pathways, lights, buildings and open issues.",
   "start": 12.35,
   "end": 15.017
  },
  {
   "text": "Choose a budget.",
   "start": 15.267,
   "end": 16.162
  },
  {
   "text": "The optimiser compares every feasible repair using path length, evening footfall, and capped coverage gains.",
   "start": 16.412,
   "end": 22.971
  },
  {
   "text": "It returns the combination that lights the most walked paths for the money.",
   "start": 23.221,
   "end": 27.187
  },
  {
   "text": "Track every report from reported, to assessed, scheduled, repaired, and field-checked.",
   "start": 27.437,
   "end": 32.352
  },
  {
   "text": "AfterDark OS.",
   "start": 32.602,
   "end": 33.737
  },
  {
   "text": "Better-lit paths.",
   "start": 33.987,
   "end": 34.961
  },
  {
   "text": "Smarter repairs.",
   "start": 35.21,
   "end": 36.274
  },
  {
   "text": "Safer campuses.",
   "start": 36.524,
   "end": 37.595
  }
 ],
