 "sentences": [
  {
   "text": "Campus lighting reports are scattered across emails, spreadsheets, and maintenance requests.",
   "start": 0,
   "end": 5.282
  },
  {
   "text": "When the budget is limited, which repair should happen first?",
   "start": 5.532,
   "end": 8.557
  },
  {
   "text": "AfterDark OS puts every report on one campus map.",
   "start": 8.808,
   "end": 12.206
  },
  {
   "text": "Pathways, lights, buildings, and open issues, in one place.",
   "start": 12.456,
   "end": 15.88
  },
  {
   "text": "Choose a budget.",
   "start": 16.13,
   "end": 17.025
  },
  {
   "text": "The optimiser compares every feasible repair using path length, evening footfall, and capped coverage gains.",
   "start": 17.275,
   "end": 23.834
  },
  {
   "text": "It returns the combination that lights the most walked paths for the money.",
   "start": 24.084,
   "end": 28.05
  },
  {
   "text": "Every report moves through a strict lifecycle: reported, assessed, scheduled, repaired, and field-checked.",
   "start": 28.299,
   "end": 34.582
  },
  {
   "text": "The coverage estimate only changes after a field check, so the map stays honest.",
   "start": 34.832,
   "end": 39.48
  },
  {
   "text": "AfterDark OS.",
   "start": 39.73,
   "end": 40.865
  },
  {
   "text": "Better-lit paths.",
   "start": 41.115,
   "end": 42.089
  },
  {
   "text": "Smarter repairs.",
   "start": 42.338,
   "end": 43.402
  },
  {
   "text": "Safer campuses.",
   "start": 43.652,
   "end": 44.723
  }
 ],
